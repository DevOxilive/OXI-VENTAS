<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(?:app|bootstrap|config|database|docker|node_modules|resources|routes|storage|tests|vendor)(?:/|$) - [F,L]
    RewriteRule ^(?:\.env|\.git|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|render\.yaml|vite\.config\.js)$ - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
